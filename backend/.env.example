# ---------------------------------------------------------------------------
# Copy this file to backend/.env and fill in real values.
# ---------------------------------------------------------------------------

# Application
APP_NAME=graphrag-portfolio-assistant
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Mock mode — set to true to run fully in-memory: no Milvus / Elasticsearch /
# Neo4j / Redis and no LLM API key required. Everything else below is ignored.
MOCK_MODE=false

# LLM (OpenAI-compatible chat completions endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# Embedding (OpenAI-compatible embeddings endpoint; may share LLM endpoint)
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-replace-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Milvus (vector store: chunk index + entity index)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_CHUNK_COLLECTION=portfolio_chunks
MILVUS_ENTITY_COLLECTION=portfolio_entities

# Elasticsearch (BM25 keyword index)
ES_HOST=localhost
ES_PORT=9200
ES_CHUNK_INDEX=portfolio_chunks

# Neo4j (knowledge graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag123

# Redis (context cache / dialogue state)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
SESSION_TTL=3600

# Retrieval tuning
ENTITY_TOP_K=5
GRAPH_HOP=2
CHUNK_TOP_K=8
VECTOR_WEIGHT=0.6
BM25_WEIGHT=0.4
SIMILARITY_THRESHOLD=0.35
